{
  "name": "bad-dos-trenzinhos",
  "version": "1.0.0",
  "description": "Painel administrativo Bad_Dos_Trenzinhos",
  "main": "electron.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "devDependencies": {
    "electron": "^41.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.baddostrenzinhos.admin",
    "productName": "Bad Dos Trenzinhos - Painel",
    "asar": false,
    "files": [
      "electron.js",
      "server.js",
      "database.js",
      "admin.html",
      "painel.html",
      "index.html",
      ".env",
      "mods.db",
      "uploads/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "allowScripts": {
    "electron@41.10.7": true,
    "electron-winstaller@5.4.0": true
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-session": "^1.19.0",
    "multer": "^2.5.0",
    "socket.io": "^4.8.4"
  }
}
